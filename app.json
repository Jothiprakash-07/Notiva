{
  "expo": {
    "name": "Reminder54",
    "slug": "Reminder54",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/notiva-logo.png",
    "scheme": "reminder54",
    "userInterfaceStyle": "automatic",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#4D3FE6",
        "foregroundImage": "./assets/images/notiva-logo.png",
        "backgroundImage": "./assets/images/notiva-logo.png",
        "monochromeImage": "./assets/images/notiva-logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.Reminder54",
      "permissions": [
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },

    "web": {
      "output": "static",
      "favicon": "./assets/images/notiva-logo.png"
    },

    "plugins": [
      "expo-router",

      [
        "expo-splash-screen",
        {
          "image": "./assets/images/notiva-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#4D3FE6",
          "dark": {
            "backgroundColor": "#4D3FE6"
          }
        }
      ],

      [
        "@react-native-community/datetimepicker",
        {
          "android": {
            "datePicker": {
              "colorAccent": {
                "light": "#4D3FE6",
                "dark": "#4D3FE6"
              },
              "colorControlActivated": {
                "light": "#4D3FE6",
                "dark": "#4D3FE6"
              },
              "colorControlHighlight": {
                "light": "#EFEDFF",
                "dark": "#EFEDFF"
              },
              "textColorPrimary": {
                "light": "#171329",
                "dark": "#171329"
              },
              "textColorSecondary": {
                "light": "#797487",
                "dark": "#797487"
              },
              "windowBackground": {
                "light": "#FFFFFF",
                "dark": "#FFFFFF"
              }
            },

            "timePicker": {
              "background": {
                "light": "#FFFFFF",
                "dark": "#FFFFFF"
              },
              "headerBackground": {
                "light": "#4D3FE6",
                "dark": "#4D3FE6"
              },
              "numbersBackgroundColor": {
                "light": "#F7F7FC",
                "dark": "#F7F7FC"
              },
              "numbersSelectorColor": {
                "light": "#4D3FE6",
                "dark": "#4D3FE6"
              },
              "numbersTextColor": {
                "light": "#171329",
                "dark": "#171329"
              }
            }
          }
        }
      ],

      [
        "expo-notifications",
        {
          "color": "#4D3FE6"
        }
      ],

      "expo-secure-store",
      "./plugins/withNativeAlarm"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "aa0a4911-49b8-4a4e-a7df-24b78eec6414"
      }
    }
  }
}